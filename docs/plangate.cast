[4.237929, "o", "=== SDF PlanGate Demo ===\r\nScenario: unsafe_write\r\nMode: local (sdf-plan)\r\n\r\nAgent proposed plan with 2 steps.\r\nRunning PlanGate (policy + lint)...\r\n\r\nBLOCKED: unsafe write requires confirmation\r\nLint:\r\n  - WARN NO_VERIFY_BEFORE_WRITE at step S2\r\nPolicy:\r\n  - requires_confirm: True\r\n  - confirm_prompt: \"Confirm before executing side-effecting action\"\r\n\r\nAUTO_CONFIRM=1 -> simulating YES\r\nCONFIRMED\r\nRe-running PlanGate..."]
[4.238434, "o", "\r\n\r\nPASSED: safe to proceed\r\nExecuting S2: \"Apply production config change\"\r\nWRITE EXECUTED (demo)\r\nDone.\r\n"]
